# ==========================================
# Server Configuration
# ==========================================
PORT=8083
SERVER_PORT=8083
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://*.vercel.app

# ==========================================
# Database Configuration (MySQL)
# ==========================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_campus_placement
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here
DB_URL=jdbc:mysql://localhost:3306/smart_campus_placement?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# ==========================================
# JPA / Hibernate Configuration
# ==========================================
JPA_DDL_AUTO=update
SHOW_SQL=true
HIBERNATE_FORMAT_SQL=true
OPEN_IN_VIEW=false
